{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the LearnLayer windows may ask the native side to do.",
  "windows": ["main", "pill", "reader-*", "overlay"],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "ms-settings:privacy-microphone"
        }
      ]
    },
    "deep-link:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://**"
        },
        {
          "url": "http://127.0.0.1:*/**"
        },
        {
          "url": "http://localhost:*/**"
        }
      ]
    }
  ]
}
